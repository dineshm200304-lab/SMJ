      <button onclick="closeRegistrationModal()" class="absolute top-4 right-4 text-brand-muted hover:text-white p-1 rounded-lg text-lg focus:outline-none">
        ✕
      </button>

      <div class="mb-4">
        <span class="highlight-pill text-brand-accent px-2.5 py-0.5 rounded text-[11px] font-bold uppercase">Online Coach-Led Session</span>
        <h3 class="text-xl font-extrabold text-white mt-2">Lock Your ₹99 Webinar Seat</h3>
        <p class="text-xs text-brand-muted mt-1">Get immediate access instructions via Email & WhatsApp.</p>
      </div>

      <!-- Registration Form -->
      <form id="webinarForm" onsubmit="handleRegistrationSubmit(event)" class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Your Full Name</label>
          <input type="text" id="userName" required placeholder="e.g. Arun Kumar" class="w-full px-3.5 py-2.5 rounded-lg bg-brand-card border border-brand-border text-white text-sm focus:outline-none focus:border-brand-accent placeholder-slate-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">WhatsApp Number (For Link & Reminder)</label>
          <div class="flex">
            <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-brand-border bg-brand-card text-xs text-brand-muted font-bold">+91</span>
            <input type="tel" id="userPhone" pattern="[0-9]{10}" required placeholder="9876543210" class="w-full px-3.5 py-2.5 rounded-r-lg bg-brand-card border border-brand-border text-white text-sm focus:outline-none focus:border-brand-accent placeholder-slate-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
          <input type="email" id="userEmail" required placeholder="arun@example.com" class="w-full px-3.5 py-2.5 rounded-lg bg-brand-card border border-brand-border text-white text-sm focus:outline-none focus:border-brand-accent placeholder-slate-500">
        </div>

        <!-- Order Summary Pill -->
        <div class="p-3 bg-brand-card rounded-lg border border-brand-border/80 flex items-center justify-between text-xs">
          <span class="text-slate-300">Registration Fee:</span>
          <span class="font-extrabold text-white text-sm text-brand-accent">₹99 Only</span>
        </div>

        <button type="submit" id="submitBtn" class="w-full py-3 bg-brand-accent hover:bg-brand-accentHover text-white font-extrabold text-sm rounded-lg shadow-glow transition transform active:scale-95 flex items-center justify-center gap-2">
          <span>PROCEED TO PAY ₹99</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>

        <p class="text-[11px] text-center text-brand-muted mt-2">
          🔒 Secure 256-bit encrypted checkout (UPI, GPay, PhonePe, Cards)
        </p>
      </form>

      <!-- Success State view (Hidden initially) -->
      <div id="modalSuccessState" class="hidden text-center py-6">
        <div class="w-14 h-14 bg-emerald-950/70 border border-emerald-500 rounded-full flex items-center justify-center text-emerald-400 text-2xl mx-auto mb-3">
          ✓
        </div>
        <h4 class="text-lg font-bold text-white mb-1">You Are Registered!</h4>
        <p class="text-xs text-slate-300 max-w-xs mx-auto leading-relaxed mb-4">
          A confirmation with your webinar access link has been sent to your WhatsApp number and email.
        </p>
        <div class="p-3 bg-brand-card rounded-lg text-xs text-brand-accent border border-brand-accent/30 font-medium mb-4">
          "Understand first. Decide later."
        </div>
        <button onclick="closeRegistrationModal()" class="px-6 py-2 bg-brand-border hover:bg-brand-card text-white text-xs font-bold rounded-lg">
          Done
        </button>
      </div>

    </div>
  </div>

  <script>
    // Set dynamic current year in footer
    document.getElementById('currentYear').textContent = new Date().getFullYear();

    // Modal Control Functions
    function openRegistrationModal() {
      const modal = document.getElementById('registrationModal');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeRegistrationModal() {
      const modal = document.getElementById('registrationModal');
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      
      // Reset form view in case user reopens
      setTimeout(() => {
        document.getElementById('webinarForm').classList.remove('hidden');
        document.getElementById('modalSuccessState').classList.add('hidden');
      }, 300);
    }

    // Close modal on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeRegistrationModal();
    });

    // Close modal if background overlay clicked
    document.getElementById('registrationModal').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeRegistrationModal();
    });

    // Form Submission Simulation
    function handleRegistrationSubmit(event) {
      event.preventDefault();
      const submitBtn = document.getElementById('submitBtn');
      const originalText = submitBtn.innerHTML;
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Processing ₹99 Checkout...</span>`;

      // Simulating simulated checkout process
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        document.getElementById('webinarForm').classList.add('hidden');
        document.getElementById('modalSuccessState').classList.remove('hidden');
      }, 1000);
    }

    // FAQ Accordion Handler
    function toggleFaq(id) {
      const content = document.getElementById(`content-${id}`);
      const icon = document.getElementById(`icon-${id}`);
      const isHidden = content.classList.contains('hidden');

      // Close other FAQs
      ['faq1', 'faq2', 'faq3', 'faq4'].forEach((item) => {
        const c = document.getElementById(`content-${item}`);
        const i = document.getElementById(`icon-${item}`);
        if (c && i) {
          c.classList.add('hidden');
          i.textContent = '+';
          i.classList.remove('rotate-45');
        }
      });

      if (isHidden) {
        content.classList.remove('hidden');
        icon.textContent = '✕';
      }
    }
  </script>
</body>
</html>
